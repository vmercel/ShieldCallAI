{
  "expo": {
    "name": "CallShield",
    "slug": "callshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "callshield",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.callshield.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "CallShield needs microphone access to analyze live calls with SENTINEL™ AI and detect scam voices in real-time.",
        "NSContactsUsageDescription": "CallShield accesses your contacts to identify callers, show caller names, and help protect you from unknown numbers.",
        "NSCameraUsageDescription": "CallShield may use the camera for future identity verification features.",
        "NSSpeechRecognitionUsageDescription": "CallShield uses speech recognition to transcribe calls in real-time for SENTINEL™ AI threat analysis.",
        "NSLocalNetworkUsageDescription": "CallShield may use local network for VoIP call routing.",
        "UIBackgroundModes": ["voip", "audio", "fetch", "remote-notification", "processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.callshield.background-analysis"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.pushkit.voice-over-ip": true,
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#060E1E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.callshield.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.ANSWER_PHONE_CALLS",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060E1E"
        }
      ],
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "CallShield needs microphone access to analyze live calls with SENTINEL™ AI and detect scam voices in real-time."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "CallShield accesses your contacts to identify callers and protect you from unknown numbers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#00B4D8",
          "defaultChannel": "callshield-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
