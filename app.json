{
  "expo": {
    "name": "ShieldCall",
    "slug": "shieldcallai",
    "version": "1.0.0",
    "description": "Analyzes the conversation on this phone while the call is ongoing. Shows AI vs human, scam vs genuine, and likelihood on a sliding tile every chunk.",
    "githubUrl": "https://github.com/vmercel/CallShield",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shieldcallai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "extra": {
      "privacyPolicyUrl": "https://cnrgrivqmuivxpnstaom.supabase.co/functions/v1/privacy",
      "termsOfServiceUrl": "https://cnrgrivqmuivxpnstaom.supabase.co/functions/v1/terms",
      "supportUrl": "https://cnrgrivqmuivxpnstaom.supabase.co/functions/v1/support",
      "supabaseUrl": "https://cnrgrivqmuivxpnstaom.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNucmdyaXZxbXVpdnhwbnN0YW9tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwNjg4NDYsImV4cCI6MjA5MzY0NDg0Nn0.gyRbytDh1mWItvJ6sb97m0hsVUrmQTF7nzLVHeNZOKY"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shieldcallai.app",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeContacts",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ShieldCall uses the microphone to analyze this phone's conversation while a call is ongoing so it can warn you about scams.",
        "NSContactsUsageDescription": "ShieldCall reads your contacts so you can search and call people from this phone, like a Phone app.",
        "LSApplicationQueriesSchemes": ["tel", "telprompt"],
        "NSSpeechRecognitionUsageDescription": "ShieldCall uses the operating system's speech recognition to transcribe this phone's live conversation so it can score scam language. Audio may be sent to Apple or Google as your OS dictates.",
        "NSLocalNetworkUsageDescription": "ShieldCall may connect to an optional detector sidecar on your local network. The app works if that sidecar is not running.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "fetch", "remote-notification", "processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.shieldcallai.background-analysis"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.pushkit.voice-over-ip": true,
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#060E1E"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "package": "com.shieldcallai.app",
      "intentFilters": [
        {
          "action": "android.intent.action.DIAL",
          "category": ["android.intent.category.DEFAULT"]
        },
        {
          "action": "android.intent.action.DIAL",
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
          "data": [{ "scheme": "tel" }]
        },
        {
          "action": "android.intent.action.VIEW",
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
          "data": [{ "scheme": "tel" }]
        },
        {
          "action": "android.intent.action.CALL",
          "category": ["android.intent.category.DEFAULT"],
          "data": [{ "scheme": "tel" }]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.PROCESS_OUTGOING_CALLS",
        "android.permission.ANSWER_PHONE_CALLS",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "./plugins/withCallKeep.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060E1E"
        }
      ],
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "ShieldCall uses the microphone to analyze this phone's conversation while a call is ongoing so it can warn you about scams."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ShieldCall reads your contacts so you can search and call people from this phone, like a Phone app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#00B4D8",
          "defaultChannel": "shieldcallai-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
