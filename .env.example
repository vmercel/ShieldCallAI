# ShieldCallAI environment template.
# Copy to .env and fill in real values, then restart the dev server.
# NEVER commit .env: it is git-ignored and may hold secrets.

# Supabase project URL. Optional: the app defaults to the project's hosted
# URL when this is unset, but setting it explicitly is recommended.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (publishable) key. REQUIRED.
# The app refuses to boot without it. Find it in the Supabase dashboard
# under Project Settings > API > anon public.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local detector sidecar URL. Optional: defaults to http://127.0.0.1:8765
# (on a physical device the app falls back to the Metro host IP).
EXPO_PUBLIC_SHIELDCALL_URL=http://127.0.0.1:8765

# ---------------------------------------------------------------------------
# Edge function secrets are NOT set here. Configure them with:
#   supabase secrets set DEEPGRAM_API_KEY=... ANTHROPIC_API_KEY=... \
#     ONSPACE_AI_API_KEY=... ONSPACE_AI_BASE_URL=...
# They are read via Deno.env by supabase/functions/*
# (transcribe-audio, ghost-ai, ai-dialer, sentinel-analysis, ...).
# SUPABASE_URL / SUPABASE_ANON_KEY are provided to edge functions
# automatically by the Supabase platform.
# ---------------------------------------------------------------------------
