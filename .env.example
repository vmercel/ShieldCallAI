# ShieldCallAI environment template.
# Copy to .env and fill in real values, then restart the dev server.
# NEVER commit .env: it is git-ignored and may hold secrets.

# Supabase project URL. Optional: the app defaults to the project's hosted
# URL when this is unset, but setting it explicitly is recommended.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (sb_publishable_...). REQUIRED.
# The app refuses to boot without it. Find it in the Supabase dashboard
# under Project Settings > API Keys (use the publishable key; the legacy
# anon JWT key is deprecated and deactivated on this project).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Local detector sidecar URL. Optional: defaults to http://127.0.0.1:8765
# (on a physical device the app falls back to the Metro host IP).
EXPO_PUBLIC_SHIELDCALL_URL=http://127.0.0.1:8765

# Optional: Sentry DSN for crash reporting (P1-6). Leave blank to disable;
# the app runs fine without it.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Dev-only test account (__DEV__ builds only; inert in release/TestFlight).
# When both are set, the sign-in screen offers "Continue as dev tester",
# which performs a REAL Supabase signInWithPassword with these credentials.
# There is no fabricated session: auth behaves exactly like a normal user.
# Create the account once via the app's normal sign-up flow, then paste its
# credentials here. NEVER commit real credentials; .env is git-ignored.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DEV_TEST_EMAIL=
EXPO_PUBLIC_DEV_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Edge function secrets are NOT set here. Configure them with:
#   supabase secrets set DEEPGRAM_API_KEY=... ANTHROPIC_API_KEY=... \
#     ANTHROPIC_API_KEY=xxx
#     # optional: ANTHROPIC_MODEL (defaults to claude-haiku-4-5-20251001)
# They are read via Deno.env by supabase/functions/*
# (transcribe-audio, ghost-ai, ai-dialer, sentinel-analysis, ...).
# SUPABASE_URL / SUPABASE_ANON_KEY are provided to edge functions
# automatically by the Supabase platform.
#
# P0-3 per-user quotas (requests per rolling hour, per user, per function).
# Optional: both default to 120 when unset.
#   supabase secrets set RATE_LIMIT_TRANSCRIBE_AUDIO_PER_HOUR=120 \
#     RATE_LIMIT_GHOST_AI_PER_HOUR=120
# Quotas are enforced by supabase/functions/_shared/rateLimit.ts via the
# consume_ai_quota RPC; apply supabase/migrations/*_ai_quota_usage.sql first
# with `supabase db push`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# P1-1 In-app purchase product IDs (StoreKit / Play Billing via react-native-iap).
# These are PUBLIC store product IDs, not secrets. Defaults match the SKUs the
# paywall falls back to; set them to the exact IDs created in App Store
# Connect and Google Play Console (create matching IDs on both stores).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_IAP_PRO_MONTHLY_SKU=shieldcall_pro_monthly
EXPO_PUBLIC_IAP_FAMILY_MONTHLY_SKU=shieldcall_family_monthly

# ---------------------------------------------------------------------------
# P1-2 Server-side receipt validation (supabase secrets set on the ShieldCall
# project; NEVER commit real values). Until these are set, the
# validate-receipt edge function answers 503 and purchases stay pending.
#   Apple (App Store Server API): create an App Store Connect API key
#   (Users and Access > Integrations > App Store Connect API) with access to
#   the ShieldCall AI app.
#   Google (Play Developer API): create a service account in Google Cloud,
#   grant it access in Play Console (Users and permissions), paste the full
#   JSON key below.
# ---------------------------------------------------------------------------
# supabase secrets set APPLE_IAP_ISSUER_ID=<issuer-id>
# supabase secrets set APPLE_IAP_KEY_ID=<key-id>
# supabase secrets set APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# supabase secrets set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Optional overrides (defaults match app.json):
# supabase secrets set SHIELDCALL_IOS_BUNDLE_ID=com.shieldcallai.app
# supabase secrets set SHIELDCALL_ANDROID_PACKAGE=com.shieldcallai.app
