# Copy to .env and fill in. Never commit .env.
# LiveKit Cloud (https://cloud.livekit.io) — create a project, copy these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=ghost-voice

# Already used by the ShieldCall backend — reuse the same keys.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase project (service role key: server-side only, never in the app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cost guard: politely end calls after this many minutes.
MAX_CALL_DURATION_MINUTES=10
